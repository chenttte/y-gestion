# Servidor SMTP para el formulario de contacto
SMTP_HOST=smtp.ejemplo.com
# 587 = STARTTLS, 465 = TLS directo
SMTP_PORT=587
# Opcional: "true"/"false" para forzar TLS directo (por defecto: true solo si el puerto es 465)
SMTP_SECURE=
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=

# Remitente (por defecto SMTP_USER) y destinatario de las consultas
CONTACT_FROM="Y-Gestión Web <usuario@ejemplo.com>"
CONTACT_TO=contacto@ygestion.com.py

# Puerto del servidor Node
PORT=3000
